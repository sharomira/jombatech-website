<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | JombaTech</title>
  <style>
    body { 
      font-family: sans-serif; 
      background: #050b14; 
      color: #fff; 
      padding: clamp(16px, 4vw, 40px); 
      max-width: 900px; 
      margin: 0 auto; 
      box-sizing: border-box;
    }

    .card-form { 
      background: #091527; 
      padding: clamp(16px, 3vw, 24px); 
      border-radius: 8px; 
      margin-bottom: 40px; 
      border: 1px solid #142c4c; 
    }

    label { display: block; margin-top: 10px; font-weight: bold; color: #94a3b8; }
    
    input, select { 
      width: 100%; 
      padding: 10px; 
      margin: 6px 0 16px; 
      background: #050b14; 
      color: #fff; 
      border: 1px solid #2ee0df; 
      border-radius: 4px; 
      box-sizing: border-box; 
      font-size: 0.95rem;
    }

    button { 
      background: #2ee0df; 
      color: #050b14; 
      padding: 10px 20px; 
      font-weight: bold; 
      border: none; 
      border-radius: 4px; 
      cursor: pointer; 
    }

    /* Scrollable Container for Data Tables */
    .table-responsive {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin-top: 10px;
      border: 1px solid #142c4c;
      border-radius: 6px;
    }

    table { 
      width: 100%; 
      border-collapse: collapse; 
      background: #091527; 
      min-width: 500px; /* Ensures text doesn't squish horizontally */
    }

    th, td { padding: 12px; border: 1px solid #142c4c; text-align: left; }
    th { color: #2ee0df; }

    .action-buttons {
      display: flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-edit { background: #ffaa00; color: #050b14; padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    .btn-delete { background: #ff4d4d; color: #fff; padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    
    /* Modal Styles */
    .modal { display: none; position: fixed; z-index: 100; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); }
    
    .modal-content { 
      background: #091527; 
      margin: 15% auto; 
      padding: 20px; 
      border: 1px solid #2ee0df; 
      border-radius: 8px; 
      width: 90%; 
      max-width: 500px; 
      box-sizing: border-box;
    }

    .modal-actions {
      display: flex;
      gap: 10px;
      margin-top: 10px;
    }

    /* Mobile Responsive Breakpoints */
    @media (max-width: 600px) {
      .card-form button, .modal-actions button {
        width: 100%;
        margin-left: 0 !important;
        margin-bottom: 8px;
      }
      
      .modal-actions {
        flex-direction: column;
      }

      .modal-content {
        margin: 25% auto;
      }
    }
  </style>
</head>
<body>

  <h2>Product Management Dashboard</h2>

  <div class="card-form">
    <h3>Add New Product</h3>
    <form action="/admin/add-product" method="POST">
      <label>Title:</label>
      <input type="text" name="title" placeholder="e.g. HP EliteBook 840 G3" required>

      <label>Category:</label>
      <select name="category" required>
        <option value="smartphones">Smartphones</option>
        <option value="laptops">Laptops</option>
        <option value="accessories">Accessories</option>
        <option value="repairs">Repairs & Parts</option>
      </select>

      <label>Price:</label>
      <input type="text" name="price" placeholder="e.g. KSh 32,000" required>

      <label>Image Filename or URL:</label>
      <input type="text" name="image" placeholder="e.g. laptop.jpg" required>

      <button type="submit">Save Product</button>
    </form>
  </div>

  <h3>Current Inventory</h3>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Price</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (products.length === 0) { %>
          <tr>
            <td colspan="4" style="text-align: center; color: #64748b;">No products in database yet. Add one above!</td>
          </tr>
        <% } else { %>
          <% products.forEach(product => { %>
            <tr>
              <td><%= product.title %></td>
              <td><%= product.category %></td>
              <td><%= product.price %></td>
              <td>
                <div class="action-buttons">
                  <button class="btn-edit" onclick="openEditModal('<%= product.id %>', '<%= product.title %>', '<%= product.category %>', '<%= product.price %>', '<%= product.image %>')">Edit</button>
                  
                  <form action="/admin/delete-product/<%= product.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                    <button type="submit" class="btn-delete">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <div id="editModal" class="modal">
    <div class="modal-content">
      <h3>Edit Product</h3>
      <form id="editForm" method="POST">
        <label>Title:</label>
        <input type="text" id="editTitle" name="title" required>

        <label>Category:</label>
        <select id="editCategory" name="category" required>
          <option value="smartphones">Smartphones</option>
          <option value="laptops">Laptops</option>
          <option value="accessories">Accessories</option>
          <option value="repairs">Repairs & Parts</option>
        </select>

        <label>Price:</label>
        <input type="text" id="editPrice" name="price" required>

        <label>Image Filename or URL:</label>
        <input type="text" id="editImage" name="image" required>

        <div class="modal-actions">
          <button type="submit">Update Product</button>
          <button type="button" onclick="closeEditModal()" style="background: #64748b; color: #fff;">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function openEditModal(id, title, category, price, image) {
      document.getElementById('editForm').action = '/admin/update-product/' + id;
      document.getElementById('editTitle').value = title;
      document.getElementById('editCategory').value = category;
      document.getElementById('editPrice').value = price;
      document.getElementById('editImage').value = image;
      document.getElementById('editModal').style.display = 'block';
    }

    function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
    }
  </script>

</body>
</html>
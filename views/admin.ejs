<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard | JombaTech</title>
  <style>
    body { 
      font-family: sans-serif; 
      background: #050b14; 
      color: #fff; 
      padding: clamp(16px, 4vw, 40px); 
      max-width: 1000px; 
      margin: 0 auto; 
      box-sizing: border-box;
    }

    .card-form { 
      background: #091527; 
      padding: clamp(16px, 3vw, 24px); 
      border-radius: 8px; 
      margin-bottom: 40px; 
      border: 1px solid #142c4c; 
    }

    label { display: block; margin-top: 10px; font-weight: bold; color: #94a3b8; }
    
    input, select { 
      width: 100%; 
      padding: 10px; 
      margin: 6px 0 16px; 
      background: #050b14; 
      color: #fff; 
      border: 1px solid #2ee0df; 
      border-radius: 4px; 
      box-sizing: border-box; 
      font-size: 0.95rem;
    }

    button { 
      background: #2ee0df; 
      color: #050b14; 
      padding: 10px 20px; 
      font-weight: bold; 
      border: none; 
      border-radius: 4px; 
      cursor: pointer; 
    }

    /* Drag & Drop Upload Zone */
    .drop-zone {
      border: 2px dashed #2ee0df;
      padding: 24px;
      text-align: center;
      border-radius: 6px;
      background: #050b14;
      cursor: pointer;
      margin: 6px 0 16px;
      transition: background 0.2s, border-color 0.2s;
    }

    .drop-zone:hover, .drop-zone.dragover {
      background: #0d223f;
      border-color: #ffaa00;
    }

    .drop-zone-text {
      margin: 0;
      color: #94a3b8;
      font-size: 0.95rem;
    }

    .table-responsive {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin-top: 10px;
      margin-bottom: 40px;
      border: 1px solid #142c4c;
      border-radius: 6px;
    }

    table { 
      width: 100%; 
      border-collapse: collapse; 
      background: #091527; 
      min-width: 650px;
    }

    th, td { padding: 12px; border: 1px solid #142c4c; text-align: left; }
    th { color: #2ee0df; }

    .action-buttons {
      display: flex;
      gap: 6px;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-edit { background: #ffaa00; color: #050b14; padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    .btn-delete { background: #ff4d4d; color: #fff; padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
    
    /* Modal Styles */
    .modal { display: none; position: fixed; z-index: 100; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); }
    
    .modal-content { 
      background: #091527; 
      margin: 10% auto; 
      padding: 20px; 
      border: 1px solid #2ee0df; 
      border-radius: 8px; 
      width: 90%; 
      max-width: 500px; 
      box-sizing: border-box;
      max-height: 85vh;
      overflow-y: auto;
    }

    .modal-actions {
      display: flex;
      gap: 10px;
      margin-top: 10px;
    }

    @media (max-width: 600px) {
      .card-form button, .modal-actions button {
        width: 100%;
        margin-left: 0 !important;
        margin-bottom: 8px;
      }
      
      .modal-actions {
        flex-direction: column;
      }

      .modal-content {
        margin: 10% auto;
      }
    }
  </style>
</head>
<body>

  <h2>JombaTech Administration Panel</h2>

  <!-- SECTION 1: STUDENT MANAGEMENT -->
  <div class="card-form">
    <h3>Student Records & Enrollment</h3>
    <p style="color: #94a3b8; font-size: 0.9rem;">View, modify, or delete enrolled student records below.</p>
    
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Student ID</th>
            <th>Full Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Course</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="studentsTableBody">
          <tr>
            <td colspan="6" style="text-align: center; color: #64748b;">Loading student records...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- SECTION 2: PRODUCT MANAGEMENT -->
  <div class="card-form">
    <h3>Add New Product</h3>
    <form action="/admin/add-product" method="POST" enctype="multipart/form-data">
      <label>Title:</label>
      <input type="text" name="title" placeholder="e.g. HP EliteBook 840 G3" required>

      <label>Category:</label>
      <select name="category" required>
        <option value="smartphones">Smartphones</option>
        <option value="laptops">Laptops</option>
        <option value="accessories">Accessories</option>
        <option value="repairs">Repairs & Parts</option>
      </select>

      <label>Price (Numeric value only):</label>
      <input type="number" step="0.01" min="0" name="price" placeholder="e.g. 32000" required>

      <label>Upload Product Image (File Upload):</label>
      <div id="productDropZone" class="drop-zone">
        <p class="drop-zone-text" id="productDropZoneText">📷 Drag & Drop image here, or click to select</p>
        <input type="file" id="productFileInput" name="productImage" accept="image/*" style="display: none;">
      </div>

      <label>Or Image Filename / Relative Path / External URL (Optional if file uploaded above):</label>
      <input type="text" name="image" placeholder="e.g. hp external battery.jpg or https://example.com/image.jpg">

      <button type="submit">Save Product</button>
    </form>
  </div>

  <h3>Current Inventory</h3>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Category</th>
          <th>Price</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (!products || products.length === 0) { %>
          <tr>
            <td colspan="4" style="text-align: center; color: #64748b;">No products in database yet. Add one above!</td>
          </tr>
        <% } else { %>
          <% products.forEach(product => { %>
            <tr>
              <td><%= product.title %></td>
              <td><%= product.category %></td>
              <td><%= product.price %></td>
              <td>
                <div class="action-buttons">
                  <button class="btn-edit" 
                          data-id="<%= product.id %>"
                          data-title="<%= product.title %>"
                          data-category="<%= product.category %>"
                          data-price="<%= product.price %>"
                          data-image="<%= product.image %>"
                          onclick="handleProductEdit(this)">Edit</button>
                  
                  <form action="/admin/delete-product/<%= product.id %>" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this product?');">
                    <button type="submit" class="btn-delete">Delete</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- SECTION 3: STUDY RESOURCES MANAGEMENT -->
  <div class="card-form">
    <h3>Upload Study Resource</h3>
    <p style="color: #94a3b8; font-size: 0.9rem;">Drag and drop a file, choose a local file from your PC, or paste an external URL link.</p>
    
    <form action="/admin/add-resource" method="POST" enctype="multipart/form-data">
      <label>Resource Title:</label>
      <input type="text" name="title" placeholder="e.g. Computer Packages Practical Notes" required>

      <label>Associated Course:</label>
      <input type="text" name="course" placeholder="e.g. Computer Packages" required>

      <label>Upload File (PDF, Word, Images, Zip):</label>
      <div id="dropZone" class="drop-zone">
        <p class="drop-zone-text" id="dropZoneText">📁 Drag & Drop your file here, or click to browse</p>
        <input type="file" id="fileInput" name="resourceFile" style="display: none;">
      </div>

      <label>Or External File Link / URL (Optional if file uploaded above):</label>
      <input type="url" name="fileUrl" placeholder="https://drive.google.com/...">

      <button type="submit">Upload Resource</button>
    </form>
  </div>

  <h3>Uploaded Study Resources</h3>
  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Course</th>
          <th>Resource URL</th>
        </tr>
      </thead>
      <tbody>
        <% if (!resources || resources.length === 0) { %>
          <tr>
            <td colspan="3" style="text-align: center; color: #64748b;">No study resources added yet.</td>
          </tr>
        <% } else { %>
          <% resources.forEach(resource => { %>
            <tr>
              <td><%= resource.title %></td>
              <td><%= resource.course %></td>
              <td>
                <a href="<%= resource.file_url %>" target="_blank" rel="noopener noreferrer" style="color: #2ee0df; text-decoration: underline;">
                  View File
                </a>
              </td>
            </tr>
          <% }); %>
        <% } %>
      </tbody>
    </table>
  </div>

  <!-- EDIT PRODUCT MODAL -->
  <div id="editModal" class="modal">
    <div class="modal-content">
      <h3>Edit Product</h3>
      <form id="editForm" method="POST" enctype="multipart/form-data">
        <label>Title:</label>
        <input type="text" id="editTitle" name="title" required>

        <label>Category:</label>
        <select id="editCategory" name="category" required>
          <option value="smartphones">Smartphones</option>
          <option value="laptops">Laptops</option>
          <option value="accessories">Accessories</option>
          <option value="repairs">Repairs & Parts</option>
        </select>

        <label>Price:</label>
        <input type="number" step="0.01" min="0" id="editPrice" name="price" required>

        <label>Upload New Product Image File (Optional):</label>
        <input type="file" name="productImage" accept="image/*">

        <label>Or Existing Filename / Path / URL:</label>
        <input type="text" id="editImage" name="image">

        <div class="modal-actions">
          <button type="submit">Update Product</button>
          <button type="button" onclick="closeEditModal()" style="background: #64748b; color: #fff;">Cancel</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Universal helper function for drag & drop zones
    function initDropZone(zoneId, inputId, textId) {
      const dropZone = document.getElementById(zoneId);
      const fileInput = document.getElementById(inputId);
      const dropZoneText = document.getElementById(textId);

      if (!dropZone || !fileInput) return;

      dropZone.addEventListener('click', () => fileInput.click());

      fileInput.addEventListener('change', () => {
        if (fileInput.files.length > 0) {
          dropZoneText.textContent = `📄 Selected File: ${fileInput.files[0].name}`;
          dropZone.style.borderColor = '#ffaa00';
        }
      });

      ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropZone.classList.add('dragover');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, (e) => {
          e.preventDefault();
          dropZone.classList.remove('dragover');
        }, false);
      });

      dropZone.addEventListener('drop', (e) => {
        const files = e.dataTransfer.files;
        if (files.length > 0) {
          fileInput.files = files;
          dropZoneText.textContent = `📄 Selected File: ${files[0].name}`;
          dropZone.style.borderColor = '#ffaa00';
        }
      });
    }

    // Initialize Drop Zones for both Study Resources and Add Product forms
    initDropZone('dropZone', 'fileInput', 'dropZoneText');
    initDropZone('productDropZone', 'productFileInput', 'productDropZoneText');

    // Load and Populate Students List safely
    async function fetchStudents() {
      const tbody = document.getElementById('studentsTableBody');
      try {
        const response = await fetch('/api/admin/students', {
          method: 'GET',
          headers: {
            'Content-Type': 'application/json'
          },
          credentials: 'include'
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.error || `Server responded with status ${response.status}`);
        }

        const students = await response.json();

        if (students.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" style="text-align: center; color: #64748b;">No students registered yet.</td></tr>';
          return;
        }

        tbody.innerHTML = '';
        students.forEach(student => {
          const row = document.createElement('tr');
          row.innerHTML = `
            <td></td>
            <td><input type="text" id="stu-name-${student.id}" style="margin:0;"></td>
            <td><input type="email" id="stu-email-${student.id}" style="margin:0;"></td>
            <td><input type="text" id="stu-phone-${student.id}" style="margin:0;"></td>
            <td><input type="text" id="stu-course-${student.id}" style="margin:0;"></td>
            <td>
              <div class="action-buttons">
                <button class="btn-edit" onclick="updateStudent(${student.id})">Save</button>
                <button class="btn-delete" onclick="deleteStudent(${student.id})">Delete</button>
              </div>
            </td>
          `;

          row.cells[0].textContent = student.student_id || '';
          row.querySelector(`#stu-name-${student.id}`).value = student.full_name || '';
          row.querySelector(`#stu-email-${student.id}`).value = student.email || '';
          row.querySelector(`#stu-phone-${student.id}`).value = student.phone || '';
          row.querySelector(`#stu-course-${student.id}`).value = student.course || '';

          tbody.appendChild(row);
        });
      } catch (err) {
        tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: #ff4d4d;">Failed to load students: ${err.message}</td></tr>`;
      }
    }

    // Update Student Record
    async function updateStudent(id) {
      const payload = {
        fullName: document.getElementById(`stu-name-${id}`).value,
        email: document.getElementById(`stu-email-${id}`).value,
        phone: document.getElementById(`stu-phone-${id}`).value,
        course: document.getElementById(`stu-course-${id}`).value
      };

      try {
        const response = await fetch(`/api/admin/students/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload)
        });

        const data = await response.json();
        if (response.ok) {
          alert('Student record updated!');
        } else {
          alert('Error: ' + (data.error || 'Failed to update student.'));
        }
      } catch (error) {
        alert('Network request failed.');
      }
    }

    // Delete Student Record
    async function deleteStudent(id) {
      if (!confirm('Are you sure you want to permanently delete this student record?')) return;

      try {
        const response = await fetch(`/api/admin/students/${id}`, { 
          method: 'DELETE',
          credentials: 'include'
        });

        const data = await response.json();
        if (response.ok) {
          alert('Student deleted successfully!');
          fetchStudents();
        } else {
          alert('Error: ' + (data.error || 'Failed to delete student.'));
        }
      } catch (error) {
        alert('Network request failed.');
      }
    }

    // Product Modal Helpers using dataset attributes
    function handleProductEdit(btn) {
      const id = btn.dataset.id;
      document.getElementById('editForm').action = '/admin/update-product/' + id;
      document.getElementById('editTitle').value = btn.dataset.title;
      document.getElementById('editCategory').value = btn.dataset.category;
      document.getElementById('editPrice').value = btn.dataset.price;
      document.getElementById('editImage').value = btn.dataset.image;
      document.getElementById('editModal').style.display = 'block';
    }

    function closeEditModal() {
      document.getElementById('editModal').style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', fetchStudents);
  </script>

</body>
</html>